{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "routes": [
    { "src": "/", "dest": "/index.html" },
    { "src": "/dashboard", "dest": "/index.html" },
    { "src": "/wallets", "dest": "/wallets.html" },
    { "src": "/create", "dest": "/create-wallet.html" },
    { "src": "/import", "dest": "/import-wallet.html" },
    { "src": "/swap", "dest": "/swap.html" },
    { "src": "/earn", "dest": "/earn.html" },
    { "src": "/settings", "dest": "/settings.html" },
    { "src": "/landing", "dest": "/index.html" },
    { "src": "/(.*\\.html)", "dest": "/$1" }
  ]
}
